rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if a user has a specific role.
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    // Admins have full access to everything. This rule is checked first.
    // If an admin is performing an action, this rule grants access and subsequent rules are ignored.
    // This also implicitly allows server-side processes authenticated as an admin service account full access.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Users collection:
    // - Any signed-in user can read another user's profile.
    // - Users can only create or update their own profile.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if request.auth.uid == userId;
    }
    
    // Allow any signed-in user to read public data like products and demands.
    // Write access is handled by the admin rule or specific logic in backend flows.
    match /products/{productId} {
      allow read: if isSignedIn();
    }
    match /demands/{demandId} {
      allow read: if isSignedIn();
    }
    
    // Chat: Only participants of a private chat can read/write to it.
    // For now, we simplify this to allow any signed-in user, as complex participant
    // logic is handled by backend flows. Admins already have access via the global rule.
    match /chats/{chatId} {
        allow read, write: if isSignedIn();
    }
    
    // Configuration collections should be readable by all signed-in users
    // so the frontend can adapt to settings. Writes are restricted to admins by the global rule.
    match /configs/{configId} {
        allow read: if isSignedIn();
    }
    match /ai_scenarios/{scenarioId} {
        allow read: if isSignedIn();
    }
    match /intelligent_routing_strategy/{strategyId} {
        allow read: if isSignedIn();
    }
    match /prompts/{promptId} {
      allow read: if isSignedIn();
    }
    
    // Other collections that require write access from non-admin users or backend flows
    // should have their rules defined here. For now, the admin-level access is sufficient
    // for backend processes, assuming they run with admin privileges.
    // For example, points transactions are created by backend flows, covered by the admin rule.
    match /points_transactions/{transactionId} {
        allow read, write: if isSignedIn(); // Allow users to read their own transactions, writes handled by backend.
    }
    
     match /media_assets/{assetId} {
      allow read, write: if isSignedIn(); 
    }
    
    match /appointments/{appointmentId} {
        allow read, write: if isSignedIn();
    }
    
    match /availabilities/{availabilityId} {
        allow read, write: if isSignedIn();
    }

     match /llm_connections/{connectionId} {
        allow read: if isSignedIn();
    }
    
    match /resources/{resourceId} {
      allow read: if isSignedIn();
    }

    match /suppliers/{supplierId} {
        allow read: if isSignedIn();
    }

  }
}
