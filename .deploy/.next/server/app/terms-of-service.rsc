6:["$","h3",null,{"children":"第二条 用户注册与账户"}]
7:["$","ol",null,{"children":[["$","li",null,{"children":"用户注册时需提供真实、准确、完整且有效的个人信息，包括但不限于姓名/名称、联系方式、身份证明、地址等。本公司有权自行决定是否审核用户资质，并有权拒绝任何注册申请而不承担任何责任。"}],["$","li",null,{"children":"用户账户仅限本人/本组织使用，不得转让、出租、共享或以任何方式授权第三方使用。用户对账户下所有行为、后果及责任承担全部责任，包括但不限于因密码泄露导致的损失。"}],["$","li",null,{"children":"供应商、创意师需提供额外资质证明（如营业执照、专业证书），经平台方审核通过后方可提供服务。平台方有权随时要求补充材料或重新审核，并可单方暂停或终止用户资格。"}],["$","li",null,{"children":"用户同意平台方可使用用户个人信息进行身份验证、风险评估等，且用户无权对此提出异议。"}]]}]
8:["$","h3",null,{"children":"第三条 服务使用规则"}]
9:["$","ol",null,{"children":[["$","li",null,{"children":"用户同意使用平台仅限于合法目的，包括采购、设计建议、供需匹配等。用户必须确保其使用行为符合中国及全球当地法律法规。"}],["$","li",null,{"children":["用户承诺不利用平台或AI服务从事任何违法、违规活动，包括但不限于：",["$","ul",null,{"children":[["$","li",null,{"children":"侵犯知识产权、商业秘密、隐私权。"}],["$","li",null,{"children":"实施垄断、不正当竞争、虚假宣传。"}],["$","li",null,{"children":"危害国家安全、社会公共利益、平台方或其他用户的合法权益。"}],["$","li",null,{"children":"歧视、诽谤、骚扰、欺诈他人。"}],["$","li",null,{"children":"传播病毒、恶意软件、垃圾信息。"}]]}]]}],["$","li",null,{"children":"用户承诺不利用大模型（LLM）及平台做任何违法行为，或危害本平台其他参与方特别是平台方合法利益的行为，包括但不限于经济损失、声誉损害、技术破坏。违反者需承担全部法律责任、赔偿责任，包括但不限于赔偿平台方实际损失、预期利益损失、律师费、诉讼费等。平台方有权从用户账户扣除相关费用。"}],["$","li",null,{"className":"font-bold","children":"中国地区特别条款（醒目注明）：不得使用大规模模型和平台生成或传播涉及政治敏感、色情、暴力等内容。否则，生成者、传播者承诺承担全部法律责任、赔偿责任，包括但不限于行政处罚、刑事责任及对平台方、其他用户的赔偿。该条款适用于所有中国境内用户，并优先适用中国法律法规。平台方有权单方认定违规并采取措施，而用户无权上诉或要求赔偿。"}],["$","li",null,{"children":"用户同意平台方有权监控、审核、删除或修改用户内容和行为，而无需事先通知。若发现或怀疑违规，平台方可立即采取措施，包括但不限于警告、账户冻结、限制功能、删除内容、永久终止服务、报告相关部门、追究法律责任。平台方不对由此导致的用户损失负责。"}],["$","li",null,{"children":[["$","strong",null,{"children":"用户生成的内容知识产权归属："}],"用户对自行输入并生成的内容享有权利，但用户无条件授权平台方享有全球、非独占、永久、不可撤销的使用权，包括但不限于复制、修改、分发、商业化使用，用于平台改进、AI训练、匹配服务、推广等。用户不得使用平台生成内容从事违法活动，否则平台方有权追责并要求赔偿。"]}]]}]
a:["$","h3",null,{"children":"第四条 责任与免责"}]
b:["$","ol",null,{"children":[["$","li",null,{"children":"用户对上传、生成、传播的内容的合法性、准确性、适用性及后果承担全部责任。若因用户内容或行为导致第三方纠纷、损失，用户承担全部责任，并赔偿平台方任何直接或间接损失，包括但不限于第三方索赔、罚款、法律费用。"}],["$","li",null,{"children":"平台方仅提供AI匹配服务，但不对匹配结果、商品质量、服务效果、交易安全作出任何保证或承诺。用户自行承担所有交易风险，包括但不限于商品瑕疵、交付延误、知识产权侵权等。平台方不对用户间的任何纠纷负责。"}],["$","li",null,{"children":"平台方不对因用户操作不当、网络故障、不可抗力（如地震、洪水、网络攻击、政策变化）或其他非平台方原因导致的服务中断、数据丢失、损失负责。"}],["$","li",null,{"children":"用户同意赔偿平台方因用户任何行为（包括但不限于违规、侵权）导致的任何损失，包括但不限于经济损失、声誉损害、第三方索赔、行政处罚等。赔偿金额以平台方评估为准，用户无权异议。"}],["$","li",null,{"children":"平台方有权单方修改、暂停或终止任何服务，而无需承担责任或赔偿。"}]]}]
c:["$","h3",null,{"children":"第五条 知识产权"}]
d:["$","ol",null,{"children":[["$","li",null,{"children":"平台所有技术、界面、商标、AI模型等知识产权归本公司所有。用户不得复制、修改、反向工程、商业化使用，否则承担侵权责任并赔偿平台方损失。"}],["$","li",null,{"children":"用户上传或生成的内容，平台方享有上述授权使用权。用户不得主张对平台使用内容的任何权利。"}]]}]
e:["$","h3",null,{"children":"第六条 终止与争议解决"}]
f:["$","ol",null,{"children":[["$","li",null,{"children":"平台方有权随时单方终止或暂停用户的服务、账户，而无需理由或通知，且用户无权要求赔偿或补偿。"}],["$","li",null,{"children":"本协议适用中华人民共和国法律。任何争议首先由平台方协商解决；协商不成，提交上海市仲裁委员会仲裁，或由上海市人民法院管辖。仲裁或诉讼费用由败诉方承担。"}],["$","li",null,{"children":"用户同意放弃任何集体诉讼、陪审团审判的权利。"}]]}]
