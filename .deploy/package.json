{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:3002": "next dev -p 3002 -H 127.0.0.1",
    "genkit:dev": "genkit start -- tsx --env-file=.env src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch --env-file=.env src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "simulate-db": "node setup-local.js simulate-db",
    "test-local": "node setup-local.js test-local",
    "seed-cloud": "node scripts/seed-cloudbase.js --dry-run",
    "test-ai-flow": "node test-ai-flow.js",
    "test-mini": "node test-mini.js",
    "test-execute": "tsx --env-file=.env scripts/test-executePrompt-direct.ts",
    "test-api-execute": "tsx --env-file=.env scripts/test-api-executePrompt.ts",
    "docker:build": "docker build -t leverage-ai --build-arg HUNYUAN_API_KEY --build-arg CLOUDBASE_ENV_ID .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env.local leverage-ai",
    "start:standalone": "cross-env PORT=3000 node .next/standalone/server.js",
    "start:standalone:3006": "cross-env PORT=3006 node .next/standalone/server.js",
    "start:standalone:3007": "cross-env PORT=3007 node .next/standalone/server.js",
    "clean-deps": "node clean-deps.js",
    "diagnose": "node diagnose-build.js",
    "analyze": "node analyze-build.js",
    "build:debug": "copy debug-next.config.js next.config.js && npm run build",
    "build:safe": "copy debug-next.config.js next.config.js && set NODE_OPTIONS=--max-old-space-size=8192 && npm run build",
    "migrate:export": "tsx --env-file=.env scripts/firestore-to-tcb-migration.ts --action export",
    "migrate:import": "tsx --env-file=.env scripts/firestore-to-tcb-migration.ts --action import",
    "migrate:verify": "tsx --env-file=.env scripts/firestore-to-tcb-migration.ts --action verify",
    "migrate:dry-run": "tsx --env-file=.env scripts/firestore-to-tcb-migration.ts --action import --dry-run"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^2.11.0",
    "@genkit-ai/googleai": "1.14.1",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "critters": "^0.0.22",
    "csvtojson": "^2.0.10",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "11.9.1",
    "genkit": "1.14.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "next": "15.5.6",
    "next-themes": "^0.3.0",
    "openai": "^4.67.2",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "cross-env": "^7.0.3",
    "firebase-admin": "^13.5.0",
    "genkit-cli": "1.14.1",
    "minimist": "^1.2.8",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
