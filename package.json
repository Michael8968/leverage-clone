{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:3002": "next dev -p 3002 -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:api": "jest scripts/tcb-api-full-validation.test.js",
    "test:api:watch": "jest scripts/tcb-api-full-validation.test.js --watch",
    "deploy": "node scripts/deploy-and-validate.js",
    "deploy:validate": "node scripts/deploy-and-validate.js",
    "health-check": "node scripts/health-check.js",
    "simulate-db": "node setup-local.js simulate-db",
    "test-local": "node setup-local.js test-local",
    "seed-cloud": "node scripts/seed-cloudbase.js --dry-run",
    "seed:test-points": "node scripts/seed-test-points.js",
    "test-ai-flow": "tsx --env-file=.env test-ai-flow.js",
    "test-mini": "node test-mini.js",
    "test-mini:3002": "cross-env PORT=3002 node test-mini.js",
    "test-execute": "tsx --env-file=.env scripts/test-executePrompt-direct.ts",
    "test-api-execute": "tsx --env-file=.env scripts/test-api-executePrompt.ts",
    "test-routing:realtime": "tsx --env-file=.env scripts/test-routing-realtime.ts",
    "test-routing:async-pool": "tsx --env-file=.env scripts/test-routing-async-pool.ts",
    "test-auth-roles": "tsx --env-file=.env scripts/test-auth-roles.ts",
    "docker:build": "docker build -t leverage-ai --build-arg HUNYUAN_API_KEY --build-arg CLOUDBASE_ENV_ID .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env.local leverage-ai",
    "start:standalone": "cross-env PORT=3000 node .next/standalone/server.js",
    "start:standalone:3006": "cross-env PORT=3006 node .next/standalone/server.js",
    "start:standalone:3007": "cross-env PORT=3007 node .next/standalone/server.js",
    "clean-deps": "node clean-deps.js",
    "diagnose": "node diagnose-build.js",
    "analyze": "node analyze-build.js",
    "build:debug": "copy debug-next.config.js next.config.js && npm run build",
    "build:safe": "copy debug-next.config.js next.config.js && set NODE_OPTIONS=--max-old-space-size=8192 && npm run build",
    "migrate:export": "tsx --env-file=.env scripts/firestore-to-tcb-migration.ts --action export",
    "migrate:import": "tsx --env-file=.env scripts/firestore-to-tcb-migration.ts --action import",
    "migrate:verify": "tsx --env-file=.env scripts/firestore-to-tcb-migration.ts --action verify",
    "tcb:upload-videos": "tcb hosting:deploy --only static",
    "tcb:upload-videos:force": "tcb hosting:deploy --only static --force"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^2.11.0",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "critters": "^0.0.22",
    "csvtojson": "^2.0.10",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "^8.6.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "next": "15.5.6",
    "next-themes": "^0.3.0",
    "openai": "^4.67.2",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-toastify": "^11.0.5",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "axios": "^1.13.1",
    "cross-env": "^7.0.3",
    "cypress": "^15.5.0",
    "eslint": "9.38.0",
    "eslint-config-next": "16.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "minimist": "^1.2.8",
    "postcss": "^8",
    "puppeteer": "^24.27.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "whatwg-fetch": "^3.6.20"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testTimeout": 60000,
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@cloudbase|lucide-react)/)"
    ],
    "collectCoverageFrom": [
      "scripts/**/*.test.js",
      "src/**/*.test.{js,jsx,ts,tsx}",
      "!scripts/**/*.config.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.{js,jsx,ts,tsx}",
      "**/?(*.)+(spec|test).{js,jsx,ts,tsx}"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.(css|less|scss|sass)$": "identity-obj-proxy",
      "\\.(jpg|jpeg|png|gif|svg|mp4|webm|ogg)$": "<rootDir>/__mocks__/fileMock.js"
    }
  }
}
